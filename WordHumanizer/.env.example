# ---- LanguageTool ----------------------------------------------------------
# Public API (free tier: ~20 requests/min, 20 KB per request):
LANGUAGETOOL_URL=https://api.languagetool.org/v2/check
# Self-hosted server, e.g.:  LANGUAGETOOL_URL=http://localhost:8081/v2/check
LANGUAGETOOL_LANGUAGE=en-US
# Premium API credentials (optional)
LANGUAGETOOL_USERNAME=
LANGUAGETOOL_API_KEY=
# Characters per request. The documented hard limit is 60,000; the free public
# API accepts much less (20 KB), so keep this conservative unless self-hosting.
MAX_CHARS=18000
# Client-side rate limits (0 disables)
LANGUAGETOOL_REQUESTS_PER_MINUTE=18
LANGUAGETOOL_CHARS_PER_MINUTE=70000
LANGUAGETOOL_TIMEOUT=60
LANGUAGETOOL_MAX_RETRIES=4

# ---- Optional rewriting stage ----------------------------------------------
# none | claude
REWRITE_PROVIDER=none
# Needed only for REWRITE_PROVIDER=claude
ANTHROPIC_API_KEY=
REWRITE_MODEL=claude-opus-5-5

# ---- Web application ---------------------------------------------------------
MAX_UPLOAD_MB=50
JOB_TTL_MINUTES=120
MAX_CONCURRENT_JOBS=1
